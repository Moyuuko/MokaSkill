FILE_TYPE=FORM_DEFN VERSION=2
FORM
FIXED
PORT 64 30
HEADER "Moka skill v1.0 - 覆铜工具"
POPUP <MODEPOP> "统一倒角" "CHAMFER".
POPUP <SCOPEPOP> "外角" "OUTER".
TILE
TEXT "操作："
TLOC 2 2
ENDTEXT
FIELD mode
FLOC 18 2
ENUMSET 34
POP "MODEPOP"
ENDFIELD
TEXT "选择范围："
TLOC 2 6
ENDTEXT
FIELD corner_scope
FLOC 18 6
ENUMSET 34
POP "SCOPEPOP"
ENDFIELD
TEXT "统一倒角尺寸："
TLOC 2 10
ENDTEXT
FIELD size
FLOC 31 10
REALFILLIN 12 12
DECIMAL 4
ENDFIELD
TEXT "最小角度："
TLOC 2 14
ENDTEXT
FIELD min_angle
FLOC 31 14
REALFILLIN 12 12
DECIMAL 2
ENDFIELD
TEXT "最大角度："
TLOC 2 17
ENDTEXT
FIELD max_angle
FLOC 31 17
REALFILLIN 12 12
DECIMAL 2
ENDFIELD
TEXT "单位： design units"
TLOC 2 20
ENDTEXT
FIELD btn_apply
FLOC 2 23
MENUBUTTON "选择并应用" 18 3
ENDFIELD
FIELD btn_single
FLOC 22 23
MENUBUTTON "修改单个角点" 24 3
ENDFIELD
FIELD btn_close
FLOC 49 23
MENUBUTTON "关闭" 10 3
ENDFIELD
ENDTILE
ENDFORM
